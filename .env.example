# ============================================================
# AI Through Your Eyes — environment variables
# Copy to .env and fill in what you need.
# ============================================================

# --- Supabase (live mode) ------------------------------------
# If both are empty, the app runs in Demo Mode: submissions are
# stored only on the current device (per-browser) and the organizer
# dashboard reads them from localStorage (cross-tab sync on the
# same machine). Real phone-to-dashboard flow needs Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Public join link ----------------------------------------
# Where students open the survey (https://your-domain/survey).
# Used by the host dashboard to build the QR code and the copyable
# student link. Leave empty to use the current page origin — correct
# on the deployed domain, but useless during local preview/dev.
VITE_PUBLIC_BASE_URL=

# --- Host authentication -------------------------------------
# SHA-256 hex of the host password. Generate with:
#   node scripts/sha256.mjs "your-host-password"
# Leave empty to keep the dashboard in presenter-only mode
# (demo data only, no moderation tools).
VITE_HOST_HASH=

# --- Anti-spam ------------------------------------------------
# Minimum milliseconds between submissions from one device.
VITE_MIN_SUBMIT_INTERVAL_MS=10000