# ============================================================
# AI Spin & Share — environment variables
# Copy to .env and fill in what you need.
# ============================================================

# --- Supabase (real multiplayer mode) -----------------------
# If both are empty, the app runs in Demo Mode and stores
# submissions only on the current device (no cross-device sync).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Public join link ---------------------------------------
# Where students open the game. Used by the Host page to build
# the QR code / join link. Leave empty to use the current page
# origin automatically (works on the deployed domain).
VITE_PUBLIC_BASE_URL=

# --- AI Track registration link -----------------------------
# Official link shown on the recruitment screen. Leave empty to
# hide the "Explore the AI Track" button (guests are told to
# ask the organizers).
VITE_REGISTRATION_URL=

# --- Host moderation ----------------------------------------
# SHA-256 hash of the host password. Generate with:
#   node scripts/sha256.mjs "your-host-password"
# Leave empty to disable moderation controls (presenter view only).
VITE_HOST_HASH=

# --- Spam protection ----------------------------------------
# Minimum milliseconds between submissions from one device.
VITE_MIN_SUBMIT_INTERVAL_MS=10000